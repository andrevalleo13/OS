{
  "name": "valleos-dashboard",
  "version": "0.1.0",
  "private": true,
  "overrides": {
    "deepmerge-ts": "8.0.1",
    "puppeteer": "25.8.0"
  },
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check": "npm run typecheck && npm run lint && npm run test && npm run build",
    "postinstall": "prisma generate",
    "daemon": "tsx --tsconfig tsconfig.scripts.json scripts/daemon.ts",
    "shadow:index": "tsx --tsconfig tsconfig.scripts.json scripts/index-memory.ts",
    "shadow:verify-memory": "tsx --tsconfig tsconfig.scripts.json scripts/verify-memory.ts",
    "shadow:autonomy": "tsx --tsconfig tsconfig.scripts.json scripts/run-autonomy.ts",
    "shadow:verify-autonomy": "tsx --tsconfig tsconfig.scripts.json scripts/verify-autonomy.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.117.1",
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/language": "^6.13.1",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.14",
    "@gsap/react": "^2.1.2",
    "@lezer/highlight": "^1.2.5",
    "@lezer/markdown": "^1.8.0",
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "@tailwindcss/typography": "^0.5.20",
    "cheerio": "^1.2.0",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "d3-force": "^3.0.0",
    "date-fns": "^4.4.0",
    "date-fns-tz": "^3.2.0",
    "duck-duck-scrape": "^2.2.7",
    "framer-motion": "^13.1.0",
    "gsap": "^3.15.0",
    "lucide-react": "^1.31.0",
    "next": "16.3.1",
    "node-cron": "^4.6.0",
    "pg": "^8.23.0",
    "qrcode-terminal": "^0.12.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-markdown": "^10.1.0",
    "recharts": "^3.10.1",
    "remark-gfm": "^4.0.1",
    "swr": "^2.5.1",
    "systeminformation": "^5.33.1",
    "tailwind-merge": "^3.6.0",
    "whatsapp-web.js": "github:pedroslopez/whatsapp-web.js",
    "yaml": "^2.9.1",
    "zod": "^4.4.3",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/d3-force": "^3.0.10",
    "@types/node": "^20",
    "@types/node-cron": "^3.0.11",
    "@types/pg": "^8.21.0",
    "@types/qrcode-terminal": "^0.12.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^17.4.2",
    "eslint": "^9",
    "eslint-config-next": "16.3.1",
    "prisma": "^7.9.1",
    "tailwindcss": "^4",
    "tsx": "^4.23.12",
    "typescript": "^5",
    "vitest": "^4.1.11"
  }
}
