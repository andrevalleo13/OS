// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// Gimnasio (Gym)
model WorkoutSession {
  id        String   @id @default(uuid())
  date      DateTime @default(now())
  title     String   // e.g., "Push Hypertrophy"
  duration  Int      // in minutes
  volume    Float    // total kg moved
  exercises ExerciseLog[]
}

model ExerciseLog {
  id        String   @id @default(uuid())
  name      String   // e.g., "Incline Dumbbell Press"
  sets      Int
  reps      String   // e.g., "8-10"
  rpe       Int?
  weight    Float?   // kg
  muscleId  String   // e.g., "chest"
  sessionId String
  session   WorkoutSession @relation(fields: [sessionId], references: [id])
}

// Biometría y Salud
model BiometricLog {
  id        String   @id @default(uuid())
  date      DateTime @default(now())
  weight    Float?   // kg
  sleep     Float?   // hours
  hrv       Int?     // Heart Rate Variability
  calories  Int?
  steps     Int?     // daily steps
}

// Finanzas
model Transaction {
  id        String   @id @default(uuid())
  date      DateTime @default(now())
  amount    Float
  type      String   // "INCOME" | "EXPENSE"
  category  String
  note      String?
}

// Nutrición (Nutrition)
model FoodLog {
  id          String   @id @default(uuid())
  date        DateTime @default(now())
  description String   // Original text, e.g. "2 eggs and toast"
  calories    Int
  protein     Float
  carbs       Float
  fat         Float
  water       Float    @default(0) // en litros
  breakdown   Json?    // Detailed breakdown per ingredient
}

model Course {
  id          String       @id @default(uuid())
  name        String
  professor   String?
  schedule    String?      // e.g., "Lun/Mie 10:00"
  color       String       @default("#ff5500")
  currentGrade Float?      @default(0) // percentage 0-100
  absences    Int          @default(0)
  maxAbsences Int          @default(6)
  assignments Assignment[]
  createdAt   DateTime     @default(now())
}

model Assignment {
  id          String   @id @default(uuid())
  title       String
  dueDate     DateTime
  status      String   @default("pending") // pending, in-progress, done
  weight      Float?   // percentage of final grade
  grade       Float?   // score received
  
  courseId    String
  course      Course   @relation(fields: [courseId], references: [id])
  
  createdAt   DateTime @default(now())
}

// Second Brain (Notas)
model Note {
  id        String   @id @default(uuid())
  title     String
  content   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
