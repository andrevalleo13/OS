// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// Gimnasio (Gym)
model WorkoutSession {
  id        String        @id @default(uuid())
  date      DateTime      @default(now())
  title     String // e.g., "Push Hypertrophy"
  duration  Int // in minutes
  volume    Float // total kg moved
  exercises ExerciseLog[]

  @@index([date])
}

model ExerciseLog {
  id        String         @id @default(uuid())
  name      String // e.g., "Incline Dumbbell Press"
  sets      Int
  reps      String // e.g., "8-10"
  rpe       Int?
  weight    Float? // kg
  muscleId  String // e.g., "chest"
  sessionId String
  session   WorkoutSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
  @@index([muscleId])
}

// Biometría y Salud
model BiometricLog {
  id       String   @id @default(uuid())
  date     DateTime @default(now())
  weight   Float? // kg
  sleep    Float? // hours
  hrv      Int? // Heart Rate Variability
  calories Int?
  steps    Int? // daily steps

  @@index([date])
}

// Finanzas
model Transaction {
  id       String   @id @default(uuid())
  date     DateTime @default(now())
  amount   Float
  type     String // "INCOME" | "EXPENSE"
  category String
  note     String?

  @@index([date])
  @@index([type, date])
}

// Nutrición (Nutrition)
model FoodLog {
  id          String   @id @default(uuid())
  date        DateTime @default(now())
  description String // Original text, e.g. "2 eggs and toast"
  calories    Int
  protein     Float
  carbs       Float
  fat         Float
  water       Float    @default(0) // en litros
  breakdown   Json? // Detailed breakdown per ingredient

  @@index([date])
}

model Course {
  id           String       @id @default(uuid())
  name         String
  professor    String?
  schedule     String? // e.g., "Lun/Mie 10:00"
  color        String       @default("#ff5500")
  currentGrade Float?       @default(0) // percentage 0-100
  absences     Int          @default(0)
  maxAbsences  Int          @default(6)
  assignments  Assignment[]
  createdAt    DateTime     @default(now())

  @@index([createdAt])
}

model Assignment {
  id      String   @id @default(uuid())
  title   String
  dueDate DateTime
  status  String   @default("pending") // pending, in-progress, done
  weight  Float? // percentage of final grade
  grade   Float? // score received

  courseId String
  course   Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([courseId])
  @@index([status, dueDate])
}

// Second Brain (Notas)
model Note {
  id        String   @id @default(uuid())
  title     String
  content   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([updatedAt])
}

// Shadow Core
model ShadowConversation {
  id                     String              @id @default(uuid())
  externalKey            String              @unique
  channel                String              @default("dashboard")
  title                  String?
  summary                String?
  summarizedMessageCount Int                 @default(0)
  summaryUpdatedAt       DateTime?
  createdAt              DateTime            @default(now())
  updatedAt              DateTime            @updatedAt
  lastMessageAt          DateTime            @default(now())
  messages               ShadowMessage[]
  actions                ShadowActionAudit[]

  @@index([channel, lastMessageAt])
}

model ShadowMessage {
  id             String             @id @default(uuid())
  conversationId String
  role           String
  content        String
  mood           String?
  widget         String?
  metadata       Json?
  createdAt      DateTime           @default(now())
  conversation   ShadowConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
}

model ShadowMemory {
  id              String      @id @default(uuid())
  kind            String
  subject         String
  canonicalKey    String
  content         String
  source          String
  sourceRef       String?
  entityId        String?
  confidence      Float       @default(0.75)
  sensitive       Boolean     @default(false)
  active          Boolean     @default(true)
  lastConfirmedAt DateTime?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  entity          LifeEntity? @relation(fields: [entityId], references: [id], onDelete: SetNull)

  @@unique([kind, canonicalKey, content])
  @@index([subject, active])
  @@index([source, sourceRef])
  @@index([entityId, active])
}

model LifeEvent {
  id          String    @id @default(uuid())
  dedupeKey   String?   @unique
  type        String
  source      String
  sourceId    String?
  summary     String
  payload     Json?
  priority    Int       @default(0)
  status      String    @default("pending")
  occurredAt  DateTime
  createdAt   DateTime  @default(now())
  processedAt DateTime?

  @@index([occurredAt])
  @@index([type, occurredAt])
  @@index([status, priority, occurredAt])
  @@index([source, sourceId])
}

model ShadowActionAudit {
  id             String              @id @default(uuid())
  conversationId String?
  toolName       String
  status         String
  summary        String
  input          Json?
  result         Json?
  reversible     Boolean             @default(false)
  createdAt      DateTime            @default(now())
  conversation   ShadowConversation? @relation(fields: [conversationId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([toolName, status, createdAt])
  @@index([conversationId, createdAt])
}

model KnowledgeDocument {
  id          String           @id @default(uuid())
  source      String           @default("obsidian")
  sourceKey   String           @unique
  title       String
  path        String
  contentHash String
  summary     String?
  concepts    Json?
  active      Boolean          @default(true)
  sourceMtime DateTime
  indexedAt   DateTime         @default(now())
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  chunks      KnowledgeChunk[]

  @@index([active, indexedAt])
  @@index([path])
}

model KnowledgeChunk {
  id            String            @id @default(uuid())
  documentId    String
  position      Int
  heading       String?
  content       String
  searchText    String
  semanticTerms Json?
  tokenEstimate Int
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
  document      KnowledgeDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@unique([documentId, position])
  @@index([documentId, position])
}

model LifeEntity {
  id           String         @id @default(uuid())
  kind         String
  name         String
  canonicalKey String
  aliases      Json?
  description  String?
  confidence   Float          @default(0.7)
  sourceCount  Int            @default(1)
  firstSeenAt  DateTime       @default(now())
  lastSeenAt   DateTime       @default(now())
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  memories     ShadowMemory[]
  outgoing     LifeRelation[] @relation("RelationFrom")
  incoming     LifeRelation[] @relation("RelationTo")

  @@unique([kind, canonicalKey])
  @@index([name])
  @@index([lastSeenAt])
}

model LifeRelation {
  id           String     @id @default(uuid())
  fromEntityId String
  toEntityId   String
  type         String
  evidence     String?
  sourceRef    String?
  confidence   Float      @default(0.7)
  active       Boolean    @default(true)
  firstSeenAt  DateTime   @default(now())
  lastSeenAt   DateTime   @default(now())
  fromEntity   LifeEntity @relation("RelationFrom", fields: [fromEntityId], references: [id], onDelete: Cascade)
  toEntity     LifeEntity @relation("RelationTo", fields: [toEntityId], references: [id], onDelete: Cascade)

  @@unique([fromEntityId, toEntityId, type])
  @@index([fromEntityId, active])
  @@index([toEntityId, active])
}

model MemoryReview {
  id              String    @id @default(uuid())
  kind            String
  status          String    @default("pending")
  subject         String
  reason          String
  memoryIds       Json
  proposedContent String?
  confidence      Float     @default(0.7)
  createdAt       DateTime  @default(now())
  resolvedAt      DateTime?

  @@index([status, createdAt])
  @@index([subject, status])
}

model ObsidianRevision {
  id            String    @id @default(uuid())
  path          String
  operation     String
  beforeContent String
  afterContent  String
  beforeHash    String
  afterHash     String
  status        String    @default("applied")
  createdAt     DateTime  @default(now())
  revertedAt    DateTime?

  @@index([status, createdAt])
  @@index([path, createdAt])
}

// Shadow Proactivity (Phase 3)
model ShadowPattern {
  id              String          @id @default(uuid())
  signature       String          @unique
  kind            String
  subject         String
  title           String
  description     String
  evidence        Json
  confidence      Float           @default(0.5)
  sampleSize      Int             @default(0)
  status          String          @default("active")
  firstDetectedAt DateTime        @default(now())
  lastObservedAt  DateTime        @default(now())
  nextReviewAt    DateTime?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  insights        ShadowInsight[]

  @@index([status, kind, lastObservedAt])
  @@index([subject, status])
}

model ShadowInsight {
  id                   String                @id @default(uuid())
  dedupeKey            String                @unique
  patternId            String?
  type                 String
  title                String
  body                 String
  rationale            String?
  evidence             Json?
  urgency              Int                   @default(0)
  status               String                @default("pending")
  suggestedActionType  String?
  suggestedActionInput Json?
  availableAt          DateTime              @default(now())
  expiresAt            DateTime?
  deliveredAt          DateTime?
  actedAt              DateTime?
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  pattern              ShadowPattern?        @relation(fields: [patternId], references: [id], onDelete: SetNull)
  jobs                 ShadowAutomationJob[]

  @@index([status, availableAt, urgency])
  @@index([type, createdAt])
  @@index([patternId, status])
}

// Shadow Safe Autonomy (Phase 4)
model ShadowAutonomyPolicy {
  id                    String   @id
  mode                  String   @default("assist")
  quietStart            String   @default("23:00")
  quietEnd              String   @default("08:00")
  dailyDeliveryLimit    Int      @default(6)
  allowMacNotifications Boolean  @default(true)
  allowWhatsAppSelf     Boolean  @default(true)
  allowEmailDrafts      Boolean  @default(true)
  allowExternalSend     Boolean  @default(false)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
}

model ShadowAutomationJob {
  id               String                      @id @default(uuid())
  idempotencyKey   String                      @unique
  insightId        String?
  actionType       String
  riskLevel        String
  status           String                      @default("pending_approval")
  summary          String
  payload          Json
  requiresApproval Boolean                     @default(true)
  scheduledFor     DateTime                    @default(now())
  expiresAt        DateTime?
  approvedAt       DateTime?
  executedAt       DateTime?
  attempts         Int                         @default(0)
  maxAttempts      Int                         @default(3)
  lastError        String?
  result           Json?
  createdAt        DateTime                    @default(now())
  updatedAt        DateTime                    @updatedAt
  insight          ShadowInsight?              @relation(fields: [insightId], references: [id], onDelete: SetNull)
  executions       ShadowAutomationExecution[]

  @@index([status, scheduledFor])
  @@index([actionType, status, scheduledFor])
  @@index([insightId, status])
}

model ShadowAutomationExecution {
  id         String              @id @default(uuid())
  jobId      String
  attempt    Int
  status     String
  error      String?
  result     Json?
  startedAt  DateTime            @default(now())
  finishedAt DateTime?
  job        ShadowAutomationJob @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@unique([jobId, attempt])
  @@index([status, startedAt])
}
