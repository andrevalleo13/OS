// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// Gimnasio (Gym)
model WorkoutSession {
  id        String   @id @default(uuid())
  date      DateTime @default(now())
  title     String   // e.g., "Push Hypertrophy"
  duration  Int      // in minutes
  volume    Float    // total kg moved
  exercises ExerciseLog[]
}

model ExerciseLog {
  id        String   @id @default(uuid())
  name      String   // e.g., "Incline Dumbbell Press"
  sets      Int
  reps      String   // e.g., "8-10"
  rpe       Int?
  muscleId  String   // e.g., "chest"
  sessionId String
  session   WorkoutSession @relation(fields: [sessionId], references: [id])
}

// Biometría y Salud
model BiometricLog {
  id        String   @id @default(uuid())
  date      DateTime @default(now())
  weight    Float?   // kg
  sleep     Float?   // hours
  hrv       Int?     // Heart Rate Variability
  calories  Int?
}

// Finanzas
model Transaction {
  id        String   @id @default(uuid())
  date      DateTime @default(now())
  amount    Float
  type      String   // "INCOME" | "EXPENSE"
  category  String
  note      String?
}
